<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <!-- Default RID so WindowsAppSDKSelfContained builds (incl. CodeQL autobuild) are not AnyCPU. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <TargetPlatformMinVersion>10.0.22621.0</TargetPlatformMinVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <AiLafToken Condition="'$(AiLafToken)' == ''">$(AI_LAF_TOKEN)</AiLafToken>
    <AiLafAttestation Condition="'$(AiLafAttestation)' == ''">$(AI_LAF_ATTESTATION)</AiLafAttestation>
    <AssemblyName>mesh-ai</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <AssemblyMetadata Include="AiLafToken" Value="$(AiLafToken)" />
    <AssemblyMetadata Include="AiLafAttestation" Value="$(AiLafAttestation)" />
  </ItemGroup>
</Project>
