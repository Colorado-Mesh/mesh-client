{
  "message": {
    "encode": "^MECP/([0-3])/([A-Z][0-9]{2}(?: [A-Z][0-9]{2})*)(?: ([^ \\t\\n\\f\\r](?:.*[^ \\t\\n\\f\\r])?))?$",
    "decode": "^MECP/([0-3])/([A-Z][0-9]{2}(?: [A-Z][0-9]{2})*)(?: ([^ \\t\\n\\f\\r](?:.*[^ \\t\\n\\f\\r])?))?$"
  },
  "pax": {
    "encode": "([1-9][0-9]*)pax",
    "decode": "0*([1-9][0-9]*) ?[Pp][Aa][Xx]"
  },
  "gps": {
    "encode": "(-?(?:0|[1-9][0-9]{0,2})\\.[0-9]{1,6}),(-?(?:0|[1-9][0-9]{0,2})\\.[0-9]{1,6})",
    "decode": "([+-]?[0-9]+\\.[0-9]+), ?([+-]?[0-9]+\\.[0-9]+)",
    "validate": "gps"
  },
  "timestamp": {
    "encode": "@((?:[01][0-9]|2[0-3])[0-5][0-9])",
    "decode": "@([01]?[0-9]|2[0-3]):?([0-5][0-9])"
  },
  "language": {
    "encode": "@([a-z]{2,3}(?:-[a-z0-9]{2,8})*)",
    "decode": "@([A-Za-z]{2,3}(?:[-_][A-Za-z0-9]{2,8})*)"
  },
  "callsign": {
    "encode": "~([A-Z0-9]+(?:/[A-Z0-9]+)*)",
    "decode": "~([A-Za-z0-9/]+)",
    "validate": "callsign"
  },
  "reference": {
    "encode": "#([a-z0-9]+(?:-[a-z0-9]+)*)",
    "decode": "#([A-Za-z0-9_-]+)"
  },
  "duration": {
    "scope": "R03",
    "encode": [
      "([1-9][0-9]*)min",
      "([1-9][0-9]*)h(?:([0-5]?[0-9])min)?",
      "([1-9][0-9]*)d",
      "([1-9][0-9]*)s"
    ],
    "decode": [
      "(?:[Ee][Tt][Aa] ?)?([0-9]+) ?[Hh] ?([0-9]+) ?[Mm][Ii][Nn]",
      "(?:[Ee][Tt][Aa] ?)?([0-9]+) ?[Hh]",
      "(?:[Ee][Tt][Aa] ?)?([0-9]+) ?[Mm][Ii][Nn]",
      "(?:[Ee][Tt][Aa] ?)?([0-9]+) ?[Dd]",
      "(?:[Ee][Tt][Aa] ?)?([0-9]+) ?[Ss]",
      "^(?:[Ee][Tt][Aa] ?)?([0-9]+)(?:B|$)"
    ]
  }
}
