{
  "message": {
    "encode": "^MECP/([0-3])/([A-Z][0-9]{2}(?: [A-Z][0-9]{2})*)(?: ([^ \\t\\n\\f\\r\\u0085\\u2028\\u2029](?:[^\\n\\f\\r\\u0085\\u2028\\u2029]*[^ \\t\\n\\f\\r\\u0085\\u2028\\u2029])?))?$",
    "decode": "^MECP/([0-3])/([A-Z][0-9]{2}(?: [A-Z][0-9]{2})*)(?: ([^ \\t\\n\\f\\r\\u0085\\u2028\\u2029](?:[^\\n\\f\\r\\u0085\\u2028\\u2029]*[^ \\t\\n\\f\\r\\u0085\\u2028\\u2029])?))?$"
  },
  "pax": {
    "encode": "([1-9][0-9]*)pax",
    "decode": "0*([1-9][0-9]*) ?[Pp][Aa][Xx]",
    "validate": "pax"
  },
  "gps": {
    "encode": "(-?(?:0|[1-9][0-9]{0,2})\\.[0-9]{1,6}),(-?(?:0|[1-9][0-9]{0,2})\\.[0-9]{1,6})",
    "decode": "([+-]?[0-9]+\\.[0-9]+), ?([+-]?[0-9]+\\.[0-9]+)",
    "validate": "gps"
  },
  "timestamp": {
    "encode": "@((?:[01][0-9]|2[0-3])[0-5][0-9])",
    "decode": "@([01]?[0-9]|2[0-3]):?([0-5][0-9])"
  },
  "language": {
    "encode": "@([a-z]{2,3}(?:-[a-z0-9]{2,8})*)",
    "decode": "@([A-Za-z]{2,3}(?:[-_][A-Za-z0-9]{2,8})*)"
  },
  "callsign": {
    "encode": "~([A-Z0-9]+(?:/[A-Z0-9]+)*)",
    "decode": "~([A-Za-z0-9/]+)",
    "validate": "callsign"
  },
  "reference": {
    "encode": "#([a-z0-9]+(?:-[a-z0-9]+)*)",
    "decode": "#([A-Za-z0-9_-]+)"
  },
  "duration": {
    "scope": "R03",
    "encode": ["([1-9][0-9]*)min", "([1-9][0-9]*)h(?:([0-5]?[0-9])min)?", "([1-9][0-9]*)d"],
    "decode": [
      "(?:[Ee][Tt][Aa] ?)?([0-9]+) ?[Hh] ?([0-9]+) ?[Mm][Ii][Nn]",
      "(?:[Ee][Tt][Aa] ?)?([0-9]+) ?[Hh]",
      "(?:[Ee][Tt][Aa] ?)?([0-9]+) ?[Mm][Ii][Nn]",
      "(?:[Ee][Tt][Aa] ?)?([0-9]+) ?[Dd]",
      "^(?:[Ee][Tt][Aa] ?)?([0-9]+)([.,][0-9]+)?"
    ]
  },
  "appDesignator": {
    "scopeCategory": "U",
    "encode": "([a-z][a-z0-9-]{0,31})",
    "decode": "^([a-z][a-z0-9-]{0,31})"
  }
}
