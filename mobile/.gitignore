# Web bundle (`pnpm -C mobile run build`) and test output
/dist/
/test-results/
/playwright-report/

# Reticulum sidecar builds (scripts/build-sidecar.mjs)
# Stage crate: a build-time copy of reticulum-sidecar/ with the mobile [lib] target.
/native/.stage/
# FFI crate: Cargo.lock is seeded from reticulum-sidecar/Cargo.lock on every build.
/native/reticulum-ffi/Cargo.lock
/native/reticulum-ffi/target/
# Android executable (the iOS xcframework is ignored in ios/.gitignore).
/android/app/src/main/jniLibs/*/libmesh_client_reticulum.so
/android/app/src/main/jniLibs/*/libmesh_client_reticulum.so.partial
