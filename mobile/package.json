{
  "name": "@mesh-client/mobile",
  "version": "6.12.0",
  "private": true,
  "description": "Mesh Client for Android and iOS (Capacitor). Runs the desktop renderer, preload and main process unmodified on mobile shims.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:host": "node scripts/build-host.mjs",
    "build:sidecar": "node scripts/build-sidecar.mjs",
    "bridge": "node scripts/web-bridge.mjs",
    "sync": "node scripts/build.mjs && cap sync",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.host.json",
    "lint": "eslint . --max-warnings 0 && fallow dead-code --quiet",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "audit": "node scripts/audit.mjs",
    "check:log-ids": "node scripts/check-log-ids.mjs",
    "check:desktop-untouched": "node scripts/check-desktop-untouched.mjs",
    "lint:dead-code": "fallow dead-code --quiet"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^8.4.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/geolocation": "^8.2.5",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@sqlite.org/sqlite-wasm": "3.54.1-build1",
    "buffer": "^6.0.3",
    "events": "^3.3.0",
    "i18next": "^26.7.2",
    "lucide-react-motion": "^0.4.0",
    "memfs": "^4.80.1",
    "pako": "^2.2.0",
    "path-browserify": "^1.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "readable-stream": "^4.8.0",
    "string_decoder": "^1.3.0",
    "util": "^0.12.5",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.3",
    "@capacitor/cli": "^8.6.3",
    "@capacitor/ios": "^8.6.3",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "js-yaml": "^4.3.2",
    "jsdom": "^29.1.1",
    "mqtt": "^5.16.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^4.1.12",
    "vitest-axe": "^1.0.0-pre.5"
  }
}
