{
  "name": "mesh-client",
  "version": "5.29.0",
  "description": "Cross-platform Electron desktop client for Meshtastic, MeshCore, and Reticulum on macOS, Linux, and Windows with BLE, USB serial, Wi-Fi/TCP, MQTT, local SQLite history, and routing diagnostics.",
  "keywords": [
    "meshtastic",
    "mesh-network",
    "bluetooth",
    "mqtt",
    "electron",
    "desktop"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Colorado-Mesh/mesh-client"
  },
  "license": "MIT",
  "author": {
    "name": "Colorado Mesh",
    "email": "nv0n@coloradomesh.org"
  },
  "contributors": [
    "Joey Stanford https://github.com/rinchen",
    "dude.eth https://github.com/defidude",
    "megabear - KD5IHC",
    "Soord https://github.com/soord",
    "WB3IHY https://github.com/WB3IHY",
    "Letark https://github.com/Letark",
    "FuzzyChaos (ADL)"
  ],
  "main": "dist-electron/main/index.js",
  "scripts": {
    "act:build:linux": "node scripts/run-act.mjs build-linux",
    "act:build:linux:native": "node scripts/run-act.mjs build-linux --native",
    "act:ci": "node scripts/run-act.mjs ci",
    "act:ci:native": "node scripts/run-act.mjs ci --native",
    "act:flatpak": "node scripts/run-act.mjs flatpak",
    "act:list": "node scripts/run-act.mjs list",
    "act:pr": "node scripts/run-act.mjs pr",
    "act:pr:native": "node scripts/run-act.mjs pr --native",
    "act:pull-images": "node scripts/run-act.mjs pull-images",
    "act:reticulum": "node scripts/run-act.mjs reticulum-sidecar",
    "act:reticulum:native": "node scripts/run-act.mjs reticulum-sidecar --native",
    "act:tests": "node scripts/run-act.mjs tests",
    "act:tests:native": "node scripts/run-act.mjs tests --native",
    "build": "pnpm run build:main:prod && pnpm run build:preload && pnpm run build:renderer",
    "build:main": "node scripts/esbuild-main-build.mjs",
    "build:main:meta": "node scripts/esbuild-main-build.mjs --metafile=dist-electron/main/metafile.json",
    "build:main:minify-meta": "node scripts/esbuild-main-build.mjs --minify --metafile=dist-electron/main/meta.json",
    "build:main:prod": "node scripts/esbuild-main-build.mjs --minify",
    "build:main:size": "node scripts/print-main-bundle-size.mjs",
    "build:preload": "esbuild src/preload/index.ts --bundle --platform=node --outfile=dist-electron/preload/index.js --external:electron --format=cjs",
    "build:renderer": "vite build",
    "check:codeql-extensions": "node scripts/check-codeql-extensions.mjs",
    "check:console-log": "node scripts/check-console-log.mjs",
    "check:db-migrations": "node scripts/check-db-migrations.mjs",
    "check:electron-security": "node scripts/check-electron-security.mjs",
    "check:environment": "node scripts/check-environment.mjs",
    "check:flatpak": "node scripts/check-flatpak.mjs",
    "check:flatpak-offline-pnpm": "node scripts/check-flatpak-offline-pnpm.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:i18n:branch": "node scripts/check-i18n.mjs --branch",
    "check:insecure-temp-files": "node scripts/check-insecure-temp-files.mjs",
    "check:ipc-contract": "node scripts/check-ipc-contract.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:log-injection": "node scripts/check-log-injection.mjs",
    "check:log-panel-filter": "node scripts/check-log-panel-filter.mjs",
    "check:log-service-sinks": "node scripts/check-log-service-sinks.mjs",
    "check:pn-hosting-policy": "node scripts/check-pn-hosting-policy.mjs",
    "check:pr": "node scripts/check-pr.mjs",
    "check:protocol-string-gates": "node scripts/check-protocol-string-gates.mjs",
    "check:reticulum-decommissioned-hubs": "node scripts/check-reticulum-decommissioned-hubs.mjs",
    "check:reticulum-interface-modes": "node scripts/check-reticulum-interface-modes.mjs",
    "check:reticulum-sidecar": "bash scripts/check-reticulum-sidecar.sh",
    "check:silent-catches": "node scripts/check-silent-catches.mjs",
    "check:url-hostname-sanitization": "node scripts/check-url-hostname-sanitization.mjs",
    "check:xss-patterns": "node scripts/check-xss-patterns.mjs",
    "clean": "rm -rf dist-electron dist node_modules",
    "clean:build": "node scripts/clean-build.mjs",
    "clean:build:full": "node scripts/clean-build.mjs --full",
    "dedupe:dist": "node scripts/dedupe-dist.mjs",
    "dev": "node scripts/run-dev.mjs",
    "predist": "pnpm run dedupe:dist",
    "dist": "pnpm run build && electron-builder --publish never",
    "dist:linux": "pnpm run dedupe:dist && pnpm run build && electron-builder --linux --x64 --arm64 --publish never && node scripts/verify-linux-packaging.mjs",
    "dist:linux:publish": "pnpm run dedupe:dist && pnpm run build && electron-builder --linux --x64 --arm64 --publish always && node scripts/verify-linux-packaging.mjs",
    "dist:mac": "pnpm run dedupe:dist && pnpm run build && electron-builder --mac --publish never && node scripts/verify-mac-packaging.mjs",
    "dist:mac:publish": "pnpm run dedupe:dist && pnpm run build && electron-builder --mac --publish always && node scripts/verify-mac-packaging.mjs",
    "dist:win": "pnpm run build && node scripts/dist-win-hoisted-install.mjs && electron-builder --win --publish never && node scripts/verify-win-packaging.mjs && node scripts/dist-win-restore-node-modules.mjs",
    "dist:win:publish": "pnpm run build && node scripts/dist-win-hoisted-install.mjs && electron-builder --win --publish always && node scripts/verify-win-packaging.mjs && node scripts/dist-win-restore-node-modules.mjs",
    "docs:build": "node scripts/run-mkdocs.mjs build",
    "docs:install": "node scripts/install-mkdocs-deps.mjs",
    "docs:licenses": "node scripts/generate-third-party-licenses.mjs",
    "docs:serve": "node scripts/run-mkdocs.mjs serve",
    "electron:open": "node scripts/start-electron.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md,sh}\" && sort-package-json --ignore \"**/*.md\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md,sh}\" && sort-package-json --check --ignore \"**/*.md\"",
    "i18n:auto-translate": "node scripts/i18n-auto-translate.mjs",
    "i18n:prune-unused": "node scripts/prune-i18n-unused.mjs",
    "preinstall": "node scripts/check-package-manager.mjs && pnpm dlx only-allow pnpm",
    "postinstall": "node scripts/rebuild-native.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "prepare": "git config core.hooksPath .githooks",
    "rebuild": "node scripts/rebuild-native.mjs",
    "release": "bash scripts/release.sh",
    "reticulum:config:check": "node scripts/reticulum-config-check.mjs",
    "reticulum:rsnomad:clippy": "bash scripts/clone-ratspeak-stack.sh && bash scripts/check-rsnomad.sh",
    "reticulum:rsnomad:fmt:check": "bash scripts/clone-ratspeak-stack.sh && bash scripts/check-rsnomad-fmt.sh",
    "reticulum:sidecar:build": "bash scripts/ensure-rsReticulum-patches.sh && cd reticulum-sidecar && cargo build --features rns-stack,rns-ble,rns-rnode-tcp",
    "reticulum:sidecar:clean": "cd reticulum-sidecar && cargo clean",
    "reticulum:sidecar:clippy": "bash scripts/clone-ratspeak-stack.sh && cd reticulum-sidecar && cargo clippy --all-targets -- -D warnings",
    "reticulum:sidecar:clippy:full": "bash scripts/clone-ratspeak-stack.sh && cd reticulum-sidecar && cargo clippy --all-targets --features rns-stack,rns-ble,rns-rnode-tcp -- -D warnings",
    "reticulum:sidecar:coverage": "bash scripts/clone-ratspeak-stack.sh && cd reticulum-sidecar && cargo llvm-cov --features rns-stack,rns-ble,rns-rnode-tcp --html --ignore-filename-regex 'rsReticulum|rsLXMF|rsNomad'",
    "reticulum:sidecar:dev": "bash scripts/ensure-rsReticulum-patches.sh && cd reticulum-sidecar && cargo run --features rns-stack,rns-ble,rns-rnode-tcp -- --headless --port 19437",
    "reticulum:sidecar:fmt": "cd reticulum-sidecar && cargo fmt",
    "reticulum:sidecar:fmt:check": "cd reticulum-sidecar && cargo fmt --check",
    "reticulum:sidecar:test": "bash scripts/clone-ratspeak-stack.sh && cd reticulum-sidecar && cargo test --features rns-stack,rns-ble,rns-rnode-tcp",
    "reticulum:sidecar:test:full": "pnpm run reticulum:sidecar:test",
    "setup:actionlint": "node scripts/install-actionlint.mjs",
    "setup:build-deps": "node scripts/setup-build-deps.mjs",
    "setup:dialout": "node scripts/setup-dialout.mjs",
    "start": "pnpm run build && ELECTRON_ENABLE_SECURITY_WARNINGS=1 node scripts/start-electron.mjs",
    "sync:flatpak-electron": "node scripts/sync-flatpak-electron.mjs",
    "test": "vitest",
    "test:changed": "vitest run --changed HEAD",
    "test:coverage": "vitest run --coverage",
    "test:coverage:merge": "vitest run --merge-reports --coverage",
    "test:e2e": "playwright test",
    "test:e2e:build": "pnpm run build && playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:logic": "vitest run --project renderer-logic",
    "test:main": "vitest run --project main",
    "test:run": "vitest run",
    "test:staged": "node scripts/precommit-tests.mjs",
    "test:ui": "vitest run --project renderer-ui",
    "test:verbose": "vitest run --reporter=verbose",
    "trace-deprecation": "pnpm run build && NODE_OPTIONS='--trace-deprecation' node scripts/start-electron.mjs",
    "typecheck": "pnpm exec tsc --noEmit && pnpm exec tsc --noEmit -p tsconfig.main.json && pnpm exec tsc --noEmit -p tsconfig.e2e.json",
    "typecheck:strict-shared": "pnpm exec tsc --noEmit -p tsconfig.strict.json",
    "update": "bash scripts/update.sh"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.14.0",
    "@meshtastic/protobufs": "npm:@jsr/meshtastic__protobufs@^2.7.26",
    "@stoprocent/noble": "^2.8.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@zip.js/zip.js": "^2.8.53",
    "builder-util-runtime": "9.7.0",
    "dompurify": "^3.4.14",
    "electron-updater": "^6.8.9",
    "emoji-picker-element": "^1.29.1",
    "esptool-js": "0.4.5",
    "i18next": "^26.4.0",
    "js-md5": "^0.8.3",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.1",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react-motion": "^0.4.0",
    "mgrs": "^2.2.0",
    "motion": "^12.43.0",
    "mqtt": "^5.15.2",
    "node-forge": "^1.4.0",
    "qrcode": "^1.5.4",
    "react-i18next": "^17.0.12",
    "react-leaflet-cluster": "^4.1.3",
    "readable-stream": "^4.7.0",
    "semver": "^7.8.5",
    "systeminformation": "^5.33.1"
  },
  "devDependencies": {
    "@axe-core/react": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@liamcottle/meshcore.js": "^1.15.0",
    "@meshtastic/core": "npm:@jsr/meshtastic__core@^2.6.6",
    "@meshtastic/transport-http": "npm:@jsr/meshtastic__transport-http@^0.2.1",
    "@meshtastic/transport-web-serial": "npm:@jsr/meshtastic__transport-web-serial@^0.2.5",
    "@michaelhart/meshcore-decoder": "^0.3.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.10",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/js-md5": "^0.8.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^25.9.5",
    "@types/node-forge": "^1.3.14",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "concurrently": "^9.2.4",
    "electron": "^41.10.6",
    "electron-builder": "^26.15.7",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-electron": "^7.0.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-no-secrets": "^2.3.3",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "leaflet": "^1.9.4",
    "markdownlint-cli2": "^0.22.1",
    "prettier": "^3.9.6",
    "prettier-plugin-sh": "^0.18.1",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.10.1",
    "sort-package-json": "^3.7.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vitest-axe": "1.0.0-pre.5",
    "zustand": "^5.0.15"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.0.0"
  }
}
