+    /// mesh-client slow-RF announce filter (default on): a slow interface
+    /// must not queue internet-learned announces, but must queue local and
+    /// RF-learned destinations; disabling the filter restores stock queueing.
+    #[test]
+    fn slow_rf_filter_suppresses_internet_learned_announces() {
+        let (mut actor, _tx) = TransportActor::new();
+        assert!(actor.slow_rf_announce_filter_enabled, "filter defaults on");
+
+        let (mut slow, _slow_rx) = make_test_interface("rnode_lora");
+        slow.bitrate = 3_125;
+        actor.interfaces.insert(1, slow);
+        let (fast, _fast_rx) = make_test_interface("tcp_hub");
+        actor.interfaces.insert(2, fast);
+
+        // Internet-learned destination: live path via the fast hub.
+        let (raw_net, dest_net) = make_valid_announce("test.slowrf.net", 0);
+        actor.path_table.insert(
+            dest_net,
+            crate::path_table::PathEntry::new(None, 1, 2, InterfaceMode::Gateway),
         );
+        actor.broadcast_announce_on_interfaces(&raw_net, None);
+        assert_eq!(
+            actor.interfaces.get(&1).unwrap().announce_queue.len(),
+            0,
+            "slow RF must not queue internet-learned announces"
+        );
+        assert_eq!(
+            actor.interfaces.get(&2).unwrap().announce_queue.len(),
+            1,
+            "fast interfaces keep stock queueing"
+        );
+
+        // RF-learned destination: live path via the slow interface itself.
+        let (raw_rf, dest_rf) = make_valid_announce("test.slowrf.rf", 0);
+        actor.path_table.insert(
+            dest_rf,
+            crate::path_table::PathEntry::new(None, 1, 1, InterfaceMode::Gateway),
+        );
+        actor.broadcast_announce_on_interfaces(&raw_rf, None);
+        assert!(
+            actor
+                .interfaces
+                .get(&1)
+                .unwrap()
+                .announce_queue
+                .iter()
+                .any(|q| q.destination_hash == dest_rf),
+            "slow RF must queue RF-learned (mesh) announces"
+        );
+
+        // Local destination on the slow interface.
+        let (raw_local, dest_local) = make_valid_announce("test.slowrf.local", 0);
+        actor.local_destinations.insert(dest_local);
+        actor.broadcast_announce_on_interfaces(&raw_local, None);
+        assert!(
+            actor
+                .interfaces
+                .get(&1)
+                .unwrap()
+                .announce_queue
+                .iter()
+                .any(|q| q.destination_hash == dest_local),
+            "slow RF must queue local announces"
+        );
+
+        // Filter off: stock behaviour — internet announce now queues on RF.
+        actor.slow_rf_announce_filter_enabled = false;
+        let (raw_net2, dest_net2) = make_valid_announce("test.slowrf.net2", 0);
+        actor.path_table.insert(
+            dest_net2,
+            crate::path_table::PathEntry::new(None, 1, 2, InterfaceMode::Gateway),
+        );
+        actor.broadcast_announce_on_interfaces(&raw_net2, None);
+        assert!(
+            actor
+                .interfaces
+                .get(&1)
+                .unwrap()
+                .announce_queue
+                .iter()
+                .any(|q| q.destination_hash == dest_net2),
+            "filter off must restore stock queueing onto slow RF"
+        );
     }
 
