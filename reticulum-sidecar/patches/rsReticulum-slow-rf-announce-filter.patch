+    /// mesh-client slow-RF announce policy: should an unsolicited rebroadcast
+    /// of `destination_hash` be queued onto interface `target`?
+    ///
+    /// Python queues every mode-eligible announce onto every interface. On a
+    /// node bridging fast boundary hubs (thousands of destinations) onto a
+    /// LoRa RNode (~3 kbps, `ANNOUNCE_CAP` spacing \u2248 2-3 announces/min), that
+    /// backlog can never drain and starves fresh local announces. When the
+    /// filter is enabled, a slow-RF target only accepts destinations that are
+    /// local to this instance or whose live path was learned over an RF or
+    /// internal/local-client edge (i.e. the RF segment's own mesh traffic).
+    /// Internet destinations remain reachable from RF peers on demand: path
+    /// requests are answered with attached cached responses
+    /// (`admit_cached_response`), which bypass this queue entirely.
+    fn slow_rf_announce_admitted(&self, target: InterfaceId, destination_hash: &[u8; 16]) -> bool {
+        if !self.slow_rf_announce_filter_enabled {
+            return true;
+        }
+        let Some(entry) = self.interfaces.get(&target) else {
+            return false;
+        };
+        // Unknown bitrate (0) is treated as fast: only known-slow RF is gated.
+        if entry.bitrate == 0 || entry.bitrate > SLOW_RF_ANNOUNCE_MAX_BITRATE_BPS {
+            return true;
+        }
+        if self.local_destinations.contains(destination_hash) {
+            return true;
+        }
+        if let Some(path) = self.path_table.get_live(destination_hash) {
+            if let Some(source) = self.interfaces.get(&path.interface_id) {
+                return (source.bitrate > 0 && source.bitrate <= SLOW_RF_ANNOUNCE_MAX_BITRATE_BPS)
+                    || source.mode == InterfaceMode::Internal
+                    || source.role == InterfaceRole::LocalClient;
+            }
+        }
+        false
     }
 
