+    /// Skip slow-start when the Link RTT is already TCP-class.
+    ///
+    /// `grow()` only promotes to [`WINDOW_MAX_FAST`] after four rounds above
+    /// [`RATE_FAST`] (6250 B/s). A 2-hop TCP hub at ~500ms RTT with
+    /// [`WINDOW_MAX_SLOW`] (10) stays at ~8 KB/s and never crosses that bar,
+    /// so a 480 KB Nomad `/media` Resource crawls ~20s. Jumping the window
+    /// on a sub-second RTT matches the observed path without touching RF.
+    pub fn promote_fast(&mut self) {
+        self.window = WINDOW_MAX_FAST;
+        self.window_max = WINDOW_MAX_FAST;
+        self.window_min = WINDOW_MIN;
+        self.fast_rate_rounds = FAST_RATE_THRESHOLD;
+        self.very_slow_rate_rounds = 0;
+    }
+
