+/// 0 for the preferred medium, 1 for the other. `Lowest` ranks both at 0 so
+/// hop count alone decides.
+fn medium_rank(medium: PathMedium, preference: PathMediumPreference) -> u8 {
+    let preferred = match preference {
+        PathMediumPreference::Lowest => return 0,
+        PathMediumPreference::Network => PathMedium::Network,
+        PathMediumPreference::Rf => PathMedium::Rf,
+    };
+    u8::from(medium != preferred)
