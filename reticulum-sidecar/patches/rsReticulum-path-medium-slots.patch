+fn slot_sort_key(entry: &PathEntry, preference: PathMediumPreference) -> (u8, u8, u8, f64) {
+    let (expired, medium, hops) = slot_rank_key(entry, preference);
+    (expired, medium, hops, -entry.timestamp)
