+/// Beacon delay after `consecutive_failures` send errors: the normal interval,
+/// doubling per failure up to [`BEACON_TX_MAX_BACKOFF_SECS`].
+pub fn beacon_tx_backoff_secs(interval: f64, consecutive_failures: u32) -> f64 {
+    if consecutive_failures == 0 {
+        return interval;
+    }
+    let mult = 2f64.powi(consecutive_failures.saturating_sub(1).min(6) as i32);
+    (interval * mult).min(BEACON_TX_MAX_BACKOFF_SECS.max(interval))
+}
