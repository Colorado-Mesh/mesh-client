+#[test]
+fn darwin_skips_vpn_tunnels_unless_explicitly_allowed() {
+    for ifname in ["utun0", "utun4", "ipsec0", "ppp0"] {
+        assert!(!interface_selectable(AutoPlatform::Darwin, ifname, None, &[]));
+        let allowed = vec![ifname.to_string()];
+        assert!(interface_selectable(
+            AutoPlatform::Darwin,
+            ifname,
+            Some(&allowed),
+            &[]
+        ));
+        assert!(interface_selectable(AutoPlatform::Other, ifname, None, &[]));
+    }
+    assert!(interface_selectable(AutoPlatform::Darwin, "en0", None, &[]));
+}
+
+#[test]
+fn beacon_tx_backoff_doubles_and_caps() {
+    assert_eq!(beacon_tx_backoff_secs(BEACON_INTERVAL, 0), BEACON_INTERVAL);
+    assert_eq!(beacon_tx_backoff_secs(BEACON_INTERVAL, 1), BEACON_INTERVAL);
+    assert_eq!(beacon_tx_backoff_secs(BEACON_INTERVAL, 2), BEACON_INTERVAL * 2.0);
+    assert_eq!(beacon_tx_backoff_secs(BEACON_INTERVAL, 3), BEACON_INTERVAL * 4.0);
+    assert_eq!(beacon_tx_backoff_secs(BEACON_INTERVAL, 50), 60.0);
+    assert_eq!(beacon_tx_backoff_secs(BEACON_INTERVAL_BG, 50), 60.0);
+}
