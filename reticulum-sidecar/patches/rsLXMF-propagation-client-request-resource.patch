+    fn start_outbound_request_resource(&mut self, packed: Vec<u8>, request_id: [u8; 16]) -> bool {
+        let Some(link) = self.link.as_mut() else {
+            return false;
+        };
+        let rtt = link.rtt.unwrap_or(Duration::from_millis(500));
+        // Single-segment only; a split request Resource is never needed for `/get`.
+        let transfer = match link.session_keys() {
+            Some(keys) if packed.len() <= MAX_EFFICIENT_SIZE => {
+                OutboundTransfer::new_encrypted(packed, true, rtt, keys).ok()
+            }
+            _ => None,
+        };
+        let Some(mut transfer) = transfer else {
+            link.fail_pending_request(&request_id);
+            return false;
+        };
+        transfer.resource.flags.is_request = true;
+        transfer.resource.request_id = Some(request_id.to_vec());
+        link.mark_request_resource_sending(&request_id);
+        tracing::debug!(
+            request_id = %hex::encode(request_id),
+            transfer_size = transfer.resource.total_size,
+            "propagation client /get request sent as Resource"
+        );
+        self.outbound_request = Some(OutboundRequestResource {
+            transfer,
+            request_id,
+            requested: false,
+        });
+        self.drive_outbound_request();
+        self.status.state != PropagationClientState::Failed
+    }
+
+    fn drive_outbound_request(&mut self) {
+        for _ in 0..16 {
+            let Some(outbound) = self.outbound_request.as_mut() else {
+                return;
+            };
+            let action = if outbound.transfer.advertised && !outbound.requested {
+                outbound.transfer.check_timeout()
+            } else {
+                outbound.transfer.tick()
+            };
+            match action {
+                TransferAction::SendAdvertisement(adv_data) => {
+                    if !self.send_outbound_request_packet(
+                        &adv_data,
+                        rns_wire::context::PacketContext::ResourceAdv,
+                    ) {
+                        self.fail_outbound_request();
+                    }
+                    // check_timeout() re-advertises until the node's first RESOURCE_REQ.
+                    return;
+                }
+                TransferAction::SendPart(_, part_data) => {
+                    if !self.send_outbound_request_packet(
+                        &part_data,
+                        rns_wire::context::PacketContext::Resource,
+                    ) {
+                        self.fail_outbound_request();
+                        return;
+                    }
+                    if !self.pending_transport.is_empty() {
+                        return;
+                    }
+                }
+                TransferAction::Complete => {
+                    self.complete_outbound_request();
+                    return;
+                }
+                TransferAction::Failed(_) => {
+                    self.fail_outbound_request();
+                    return;
+                }
+                _ => return,
+            }
+        }
+    }
+
+    fn handle_outbound_request_part_request(&mut self, encrypted_data: &[u8]) {
+        let Some(plaintext) = self
+            .link
+            .as_ref()
+            .and_then(|link| link.decrypt(encrypted_data).ok())
+        else {
+            return;
+        };
+        let resource_hash_start =
+            if plaintext.first().copied() == Some(rns_protocol::resource::HASHMAP_IS_EXHAUSTED) {
+                1 + rns_protocol::resource::MAPHASH_LEN
+            } else {
+                1
+            };
+        let Some(requested_resource_hash) =
+            plaintext.get(resource_hash_start..resource_hash_start + 32)
+        else {
+            return;
+        };
+        let Some(outbound) = self.outbound_request.as_mut() else {
+            return;
+        };
+        if requested_resource_hash != outbound.transfer.resource.resource_hash {
+            return;
+        }
+        outbound.requested = true;
+        let actions = outbound.transfer.handle_request(&plaintext);
+
+        for action in actions {
+            match action {
+                TransferAction::SendPart(_, part_data) => {
+                    if !self.send_outbound_request_packet(
+                        &part_data,
+                        rns_wire::context::PacketContext::Resource,
+                    ) {
+                        self.fail_outbound_request();
+                        return;
+                    }
+                }
+                TransferAction::SendHmu(hmu_data) => {
+                    if !self.send_outbound_request_packet(
+                        &hmu_data,
+                        rns_wire::context::PacketContext::ResourceHmu,
+                    ) {
+                        self.fail_outbound_request();
+                        return;
+                    }
+                }
+                TransferAction::SendCancel(cancel_type, resource_hash) => {
+                    let context = match cancel_type {
+                        rns_protocol::resource::CancelType::Icl => {
+                            rns_wire::context::PacketContext::ResourceIcl
+                        }
+                        rns_protocol::resource::CancelType::Rcl => {
+                            rns_wire::context::PacketContext::ResourceRcl
+                        }
+                    };
+                    let _ = self.send_outbound_request_packet(&resource_hash, context);
+                    self.fail_outbound_request();
+                    return;
+                }
+                TransferAction::Failed(_) => {
+                    self.fail_outbound_request();
+                    return;
+                }
+                TransferAction::Complete => {
+                    self.complete_outbound_request();
+                    return;
+                }
+                TransferAction::None
+                | TransferAction::SendAdvertisement(_)
+                | TransferAction::SendProof(_)
+                | TransferAction::SendRequest(_) => {}
+            }
+        }
+    }
+
+    fn handle_outbound_request_proof(&mut self, proof_data: &[u8]) {
+        let proven = self
+            .outbound_request
+            .as_mut()
+            .is_some_and(|outbound| outbound.transfer.handle_proof(proof_data));
+        if proven {
+            self.complete_outbound_request();
+        }
+    }
+
+    fn complete_outbound_request(&mut self) {
+        let Some(outbound) = self.outbound_request.take() else {
+            return;
+        };
+        if let Some(link) = self.link.as_mut() {
+            link.mark_request_resource_sent(&outbound.request_id);
+        }
+        // The response wait starts once the node has the whole request.
+        self.started_at = Some(Instant::now());
+    }
+
+    fn fail_outbound_request(&mut self) {
+        if let Some(outbound) = self.outbound_request.take() {
+            if let Some(link) = self.link.as_mut() {
+                link.fail_pending_request(&outbound.request_id);
+            }
+        }
+        self.status.state = PropagationClientState::Failed;
+    }
+
+    fn send_outbound_request_packet(
+        &mut self,
+        data: &[u8],
+        context: rns_wire::context::PacketContext,
+    ) -> bool {
+        // RESOURCE parts were link-encrypted before chunking and ride raw so the
+        // advertised map hashes still match; ADV and control frames are encrypted here.
+        if context == rns_wire::context::PacketContext::Resource {
+            return self.send_link_packet(context, rns_wire::flags::PacketType::Data, data);
+        }
+        let Some(encrypted) = self.link.as_ref().and_then(|link| link.encrypt(data).ok()) else {
+            return false;
+        };
+        self.send_link_packet(context, rns_wire::flags::PacketType::Data, &encrypted)
+    }
