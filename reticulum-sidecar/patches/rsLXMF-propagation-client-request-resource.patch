+    #[test]
+    fn oversized_purge_request_is_sent_as_request_resource() {
+        let (tx, mut rx) = mpsc::channel(256);
+        let mut client = PropagationClient::new(tx, None, None);
+        let (initiator, responder) = active_link_pair([0xE7; 16]);
+        let link_id = initiator.link_id;
+        client.link_id = Some(link_id);
+        client.link = Some(initiator);
+        client.attached_interface = Some(0);
+        client.status.state = PropagationClientState::GetRequested;
+        let haves: Vec<Vec<u8>> = (0..50u8).map(|i| vec![i; 32]).collect();
+        client.received_ids = haves.clone();
+        let inject = |client: &mut PropagationClient,
+                      context: rns_wire::context::PacketContext,
+                      payload: &[u8]| {
+            client
+                .event_tx
+                .try_send(DestinationEvent::InboundPacket {
+                    raw: link_data_packet(link_id, context, payload),
+                    interface_id: 0,
+                    metrics: Default::default(),
+                })
+                .unwrap();
+            client.drain_events(&std::collections::HashMap::new());
+        };
+        let sent_packets = |rx: &mut mpsc::Receiver<TransportMessage>| {
+            let mut packets = Vec::new();
+            while let Ok(message) = rx.try_recv() {
+                if let TransportMessage::SendLinkEndpoint {
+                    request, result_tx, ..
+                } = message
+                {
+                    let _ = result_tx.send(LinkEndpointSendResult::Sent);
+                    assert!(request.raw.len() <= rns_wire::constants::MTU);
+                    let (header, offset) =
+                        rns_wire::header::PacketHeader::unpack(&request.raw).unwrap();
+                    packets.push((header.context, request.raw[offset..].to_vec()));
+                }
+            }
+            packets
+        };
+
+        client.send_purge_request();
+        assert_eq!(client.state(), PropagationClientState::PurgeRequested);
+
+        let packets = sent_packets(&mut rx);
+        assert_eq!(packets.len(), 1);
+        let (context, adv_body) = &packets[0];
+        assert_eq!(*context, rns_wire::context::PacketContext::ResourceAdv);
+        let adv = ResourceAdvertisement::unpack(&responder.decrypt(adv_body).unwrap()).unwrap();
+        assert!(adv.flags.is_request);
+        let mut random_hash = [0u8; RANDOM_HASH_SIZE];
+        random_hash.copy_from_slice(&adv.random_hash[..RANDOM_HASH_SIZE]);
+        let mut receiver = InboundTransfer::from_advertisement(
+            adv.num_parts,
+            adv.transfer_size,
+            adv.data_size,
+            random_hash,
+            adv.resource_hash,
+            adv.flags,
+            adv.get_map_hashes(),
+            Duration::from_millis(50),
+        )
+        .unwrap();
+
+        let mut next_request = receiver.request_next();
+        for _ in 0..16 {
+            let TransferAction::SendRequest(request) = next_request else {
+                break;
+            };
+            inject(
+                &mut client,
+                rns_wire::context::PacketContext::ResourceReq,
+                &responder.encrypt(&request).unwrap(),
+            );
+            next_request = TransferAction::None;
+            for (context, body) in sent_packets(&mut rx) {
+                if context == rns_wire::context::PacketContext::Resource {
+                    let action = receiver.receive_part(body);
+                    if matches!(action, TransferAction::SendRequest(_)) {
+                        next_request = action;
+                    }
+                }
+            }
+        }
+        assert!(receiver.resource.is_complete());
+
+        let decrypt =
+            |ciphertext: &[u8]| responder.decrypt(ciphertext).map_err(|_| ResourceError::Corrupt);
+        let (assembled, proof) = receiver.complete(Some(&decrypt)).unwrap();
+        let (request_id, _, _, request_data) = Link::parse_request(&assembled).unwrap();
+        assert_eq!(adv.request_id.as_deref(), Some(&request_id[..]));
+        let value = rmpv::decode::read_value(&mut &request_data[..]).unwrap();
+        let fields = value.as_array().unwrap();
+        assert!(fields[0].is_nil());
+        let purged: Vec<Vec<u8>> = fields[1]
+            .as_array()
+            .unwrap()
+            .iter()
+            .map(|id| id.as_slice().unwrap().to_vec())
+            .collect();
+        assert_eq!(purged, haves);
+
+        inject(
+            &mut client,
+            rns_wire::context::PacketContext::ResourcePrf,
+            &proof,
+        );
+        assert!(client.outbound_request.is_none());
+        assert_eq!(client.state(), PropagationClientState::PurgeRequested);
+
+        let response = responder.create_response(&request_id, &[0xC0]).unwrap();
+        inject(
+            &mut client,
+            rns_wire::context::PacketContext::Response,
+            &response,
+        );
+        assert_eq!(client.state(), PropagationClientState::Complete);
+    }
