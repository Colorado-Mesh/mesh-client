+        online.store(true, std::sync::atomic::Ordering::SeqCst);
+        let ready = take_online_discovery_interfaces(&mut pending, &mut registered);
+        assert_eq!(ready.len(), 1);
+        assert_eq!(ready[0].id, 7);
+        assert!(pending.is_empty());
