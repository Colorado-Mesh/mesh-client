 #[test]
+fn typed_multi_file_attachments_round_trip() {
+    let a = b"one";
+    let b = b"two";
+    let expected_value = rmpv::Value::Array(vec![
+        rmpv::Value::Array(vec![
+            rmpv::Value::String("a.txt".into()),
+            rmpv::Value::Binary(a.to_vec()),
+        ]),
+        rmpv::Value::Array(vec![
+            rmpv::Value::String("b.bin".into()),
+            rmpv::Value::Binary(b.to_vec()),
+        ]),
+    ]);
+    let mut expected = Vec::new();
+    rmpv::encode::write_value(&mut expected, &expected_value).unwrap();
+    let mut d = draft();
+    d.set_file_attachments_field(&[("a.txt", a.as_slice()), ("b.bin", b.as_slice())])
+        .unwrap();
+    let m = freeze(d);
+    let field = m.fields().get(FIELD_FILE_ATTACHMENTS).unwrap();
+    assert_eq!(field.encoded(), expected.as_slice());
+    let listed = m.file_attachments().unwrap();
+    assert_eq!(listed.len(), 2);
+    assert_eq!(listed[0], ("a.txt".to_string(), a.as_slice()));
+    assert_eq!(listed[1], ("b.bin".to_string(), b.as_slice()));
+    assert_eq!(m.first_file_attachment().unwrap().unwrap().0, "a.txt");
+    let inbound = LxMessage::unpack(&m.pack().unwrap()).unwrap();
+    let inbound_files = inbound.file_attachments().unwrap();
+    assert_eq!(inbound_files.len(), 2);
+    assert_eq!(inbound_files[1], ("b.bin".to_string(), b.as_slice()));
+}
