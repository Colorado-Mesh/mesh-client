+/// Native-picker capabilities use handle-derived paths. They must remain
+/// handle-relative through the final storage open; canonicalizing them would
+/// turn them back into a replaceable pathname.
+fn is_picker_pinned_path(path: &Path) -> bool {
+    #[cfg(any(target_os = "linux", target_os = "macos"))]
+    let text = path.to_string_lossy();
+    #[cfg(target_os = "linux")]
+    if text.starts_with("/proc/self/fd/") {
+        return true;
+    }
+    #[cfg(target_os = "macos")]
+    if text.starts_with("/.vol/") {
+        return true;
+    }
+    #[cfg(not(any(target_os = "linux", target_os = "macos")))]
+    let _ = path;
+    false
+}
