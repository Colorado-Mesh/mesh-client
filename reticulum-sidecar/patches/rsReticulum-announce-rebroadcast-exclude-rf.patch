+/// LoRa / KISS-class sinks must not receive transport-mode announce rebroadcast
+/// enqueue. Bitrate ceiling ~100 kbps; also match common RNode names.
+fn iface_is_rf_sink(entry: &InterfaceEntry) -> bool {
+    const RF_BITRATE_CEILING_BPS: u64 = 100_000;
+    if entry.name.to_ascii_lowercase().contains("rnode") {
+        return true;
+    }
+    entry.bitrate > 0 && entry.bitrate < RF_BITRATE_CEILING_BPS
+}
