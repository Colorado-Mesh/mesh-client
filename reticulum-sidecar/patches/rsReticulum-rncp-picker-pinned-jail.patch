+/// Handle-derived roots (`/proc/self/fd` on Linux and `/.vol` on macOS) must
+/// remain in the returned path. Canonicalizing one turns it back into the
+/// mutable pathname that the native picker was intended to replace.
+fn is_picker_pinned_path(path: &Path) -> bool {
+    #[cfg(any(target_os = "linux", target_os = "macos"))]
+    let text = path.to_string_lossy();
+    #[cfg(target_os = "linux")]
+    if text.starts_with("/proc/self/fd/") {
+        return true;
+    }
+    #[cfg(target_os = "macos")]
+    if text.starts_with("/.vol/") {
+        return true;
+    }
+    #[cfg(not(any(target_os = "linux", target_os = "macos")))]
+    let _ = path;
+    false
+}
+
+fn resolve_under_picker_pin(jail: &Path, requested: &str) -> Result<PathBuf, String> {
+    use std::path::Component;
+
+    let requested = Path::new(requested);
+    if requested.is_absolute() {
+        return Err("outside fetch jail".into());
+    }
+    let mut resolved = jail.to_path_buf();
+    for component in requested.components() {
+        let Component::Normal(name) = component else {
+            return Err("outside fetch jail".into());
+        };
+        resolved.push(name);
+        let metadata =
+            std::fs::symlink_metadata(&resolved).map_err(|error| format!("not found: {error}"))?;
+        if metadata.file_type().is_symlink() {
+            return Err("outside fetch jail".into());
+        }
+    }
+    if !resolved.is_file() {
+        return Err("not found: requested path is not a file".into());
+    }
+    Ok(resolved)
+}
