+/// Handle-derived roots (`/proc/self/fd` on Linux and `/.vol` on macOS) must
+/// remain in the returned path. Canonicalizing one turns it back into the
+/// mutable pathname that the native picker was intended to replace.
+fn is_picker_pinned_path(path: &Path) -> bool {
+    // One cfg block per OS so clippy does not see needless_bool / needless_return
+    // after the other platform branches are cfg-stripped.
+    #[cfg(target_os = "linux")]
+    {
+        path.to_string_lossy().starts_with("/proc/self/fd/")
+    }
+    #[cfg(target_os = "macos")]
+    {
+        path.to_string_lossy().starts_with("/.vol/")
+    }
+    #[cfg(not(any(target_os = "linux", target_os = "macos")))]
+    {
+        let _ = path;
+        false
+    }
+}
+
+/// Why a fetch request names no servable path.
+#[derive(Debug, PartialEq, Eq)]
+enum FetchPathError {
+    /// Refused by the jail; the reason is reported as `FetchDenied`.
+    Outside(&'static str),
+    NotFound,
+}
+
+/// Resolve a request under a picker-pinned jail component by component,
+/// refusing absolute paths, traversal and symlinks, so the final read stays
+/// rooted at the directory handle rather than its current pathname.
+fn resolve_under_picker_pin(jail: &Path, requested: &str) -> Result<String, FetchPathError> {
+    use std::path::Component;
+
+    let requested = Path::new(requested);
+    if requested.is_absolute() {
+        return Err(FetchPathError::Outside("outside fetch jail"));
+    }
+    let mut resolved = jail.to_path_buf();
+    for component in requested.components() {
+        let Component::Normal(name) = component else {
+            return Err(FetchPathError::Outside("outside fetch jail"));
+        };
+        resolved.push(name);
+        let metadata =
+            std::fs::symlink_metadata(&resolved).map_err(|_| FetchPathError::NotFound)?;
+        if metadata.file_type().is_symlink() {
+            return Err(FetchPathError::Outside("resolves outside fetch jail"));
+        }
+    }
+    Ok(resolved.to_string_lossy().into_owned())
+}
+
+/// The local path a fetch request names under the listener's jail policy.
+fn resolve_fetch_request(jail: Option<&str>, data: &str) -> Result<String, FetchPathError> {
+    if let Some(jail) = jail
+        && is_picker_pinned_path(Path::new(jail))
+    {
+        return resolve_under_picker_pin(Path::new(jail), data);
+    }
+    let path =
+        host_fetch_request_path(jail, data).ok_or(FetchPathError::Outside("outside fetch jail"))?;
+    if let Some(jail) = jail
+        && Path::new(&path).exists()
+        && escapes_jail(&path, jail)
+    {
+        return Err(FetchPathError::Outside("resolves outside fetch jail"));
+    }
+    Ok(path)
+}
