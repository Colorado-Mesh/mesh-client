+    #[cfg(target_os = "linux")]
+    fn pinned_dir_alias(handle: &std::fs::File) -> PathBuf {
+        use std::os::fd::AsRawFd;
+        PathBuf::from(format!("/proc/self/fd/{}", handle.as_raw_fd()))
+    }
+
+    #[cfg(target_os = "macos")]
+    fn pinned_dir_alias(handle: &std::fs::File) -> PathBuf {
+        use std::os::unix::fs::MetadataExt;
+        let metadata = handle.metadata().unwrap();
+        PathBuf::from(format!("/.vol/{}/{}", metadata.dev(), metadata.ino()))
+    }
+
+    /// A native picker hands the listener a handle-derived jail
+    /// (`/proc/self/fd/N` on Linux, `/.vol/<dev>/<ino>` on macOS). The served
+    /// file must come from the directory the handle pins even after the
+    /// user-visible pathname is replaced before the read.
+    #[cfg(any(target_os = "linux", target_os = "macos"))]
+    #[test]
+    fn fetch_sink_keeps_handle_alias_after_selected_root_is_replaced() {
+        let unique = std::time::SystemTime::now()
+            .duration_since(std::time::UNIX_EPOCH)
+            .unwrap()
+            .as_nanos();
+        let dir = std::env::temp_dir().join(format!(
+            "rns-rncp-picker-pin-{}-{unique}",
+            std::process::id()
+        ));
+        let selected = dir.join("selected");
+        let moved = dir.join("moved");
+        std::fs::create_dir(&dir).unwrap();
+        std::fs::create_dir(&selected).unwrap();
+        std::fs::write(selected.join("served.txt"), b"picked").unwrap();
+        let handle = std::fs::File::open(&selected).unwrap();
+        let jail = host_jail(&pinned_dir_alias(&handle).to_string_lossy());
+
+        std::fs::rename(&selected, &moved).unwrap();
+        std::fs::create_dir(&selected).unwrap();
+        std::fs::write(selected.join("served.txt"), b"replacement").unwrap();
+
+        let path = resolve_fetch_request(Some(&jail), "served.txt").unwrap();
+        assert!(
+            path.starts_with(&jail),
+            "{path} left the pinned jail {jail}"
+        );
+        assert_eq!(std::fs::read(&path).unwrap(), b"picked");
+        assert_eq!(
+            resolve_fetch_request(Some(&jail), "../selected/served.txt"),
+            Err(FetchPathError::Outside("outside fetch jail"))
+        );
+        assert_eq!(
+            resolve_fetch_request(Some(&jail), "/etc/hosts"),
+            Err(FetchPathError::Outside("outside fetch jail"))
+        );
+        assert_eq!(
+            resolve_fetch_request(Some(&jail), "missing.txt"),
+            Err(FetchPathError::NotFound)
+        );
+        std::os::unix::fs::symlink(selected.join("served.txt"), moved.join("link.txt")).unwrap();
+        assert_eq!(
+            resolve_fetch_request(Some(&jail), "link.txt"),
+            Err(FetchPathError::Outside("resolves outside fetch jail"))
+        );
+        std::fs::remove_dir_all(&dir).unwrap();
+    }
