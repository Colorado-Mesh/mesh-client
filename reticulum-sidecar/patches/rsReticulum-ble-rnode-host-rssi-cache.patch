+/// Last advertisement / resolve-time host↔RNode RSSI (dBm), keyed by normalized
+/// BLE address or friendly name. CoreBluetooth stops advertising after GATT
+/// connect and does not refresh `PeripheralProperties.rssi`, so mesh-client
+/// seeds Interface Signal meters from this cache.
+static HOST_RSSI_BY_KEY: std::sync::OnceLock<
+    std::sync::Mutex<std::collections::HashMap<String, i16>>,
+> = std::sync::OnceLock::new();
+
+fn host_rssi_map() -> &'static std::sync::Mutex<std::collections::HashMap<String, i16>> {
+    HOST_RSSI_BY_KEY.get_or_init(|| std::sync::Mutex::new(std::collections::HashMap::new()))
+}
+
+/// Normalize `ble://…`, MAC, CoreBluetooth UUID, or RNode name for cache keys.
+pub fn host_rssi_cache_key(id: &str) -> String {
+    let trimmed = id.trim();
+    let stripped = trimmed
+        .strip_prefix("ble://")
+        .or_else(|| trimmed.strip_prefix("BLE://"))
+        .unwrap_or(trimmed)
+        .trim();
+    if stripped.is_empty() {
+        return String::new();
+    }
+    // UUID with dashes → compact lowercase hex (matches mesh-client normalizeBleMac).
+    if stripped.len() == 36
+        && stripped.as_bytes().get(8) == Some(&b'-')
+        && stripped.as_bytes().get(13) == Some(&b'-')
+        && stripped.as_bytes().get(18) == Some(&b'-')
+        && stripped.as_bytes().get(23) == Some(&b'-')
+        && stripped.chars().filter(|c| *c != '-').all(|c| c.is_ascii_hexdigit())
+    {
+        return stripped
+            .chars()
+            .filter(|c| *c != '-')
+            .map(|c| c.to_ascii_lowercase())
+            .collect();
+    }
+    // Colon- or hyphen-separated 48-bit MAC → lowercase colon form.
+    let compact: String = stripped
+        .chars()
+        .filter(|c| c.is_ascii_hexdigit())
+        .map(|c| c.to_ascii_lowercase())
+        .collect();
+    if compact.len() == 12
+        && stripped
+            .chars()
+            .all(|c| c.is_ascii_hexdigit() || c == ':' || c == '-')
+    {
+        return compact
+            .as_bytes()
+            .chunks(2)
+            .map(|pair| std::str::from_utf8(pair).unwrap_or("00"))
+            .collect::<Vec<_>>()
+            .join(":");
+    }
+    stripped.to_ascii_lowercase()
+}
+
+/// Remember host-link RSSI from an advertisement or resolve-time properties read.
+pub fn remember_host_rssi(address_or_name: &str, rssi: i16) {
+    let key = host_rssi_cache_key(address_or_name);
+    if key.is_empty() {
+        return;
+    }
+    if let Ok(mut map) = host_rssi_map().lock() {
+        map.insert(key, rssi);
+    }
+}
+
+/// Last cached host-link RSSI for a `ble://` serial_port target (address or name).
+pub fn cached_host_rssi(address_or_name: &str) -> Option<i16> {
+    let key = host_rssi_cache_key(address_or_name);
+    if key.is_empty() {
+        return None;
+    }
+    host_rssi_map()
+        .lock()
+        .ok()
+        .and_then(|map| map.get(&key).copied())
+}
+
+async fn remember_peripheral_host_rssi(peripheral: &Peripheral, extra_keys: &[&str]) {
+    let addr = peripheral.id().to_string();
+    let Ok(Some(props)) = bounded_ble_operation("properties", peripheral.properties()).await else {
+        return;
+    };
+    let Some(rssi) = props.rssi else {
+        return;
+    };
+    remember_host_rssi(&addr, rssi);
+    if let Some(ref name) = props.local_name {
+        if !name.is_empty() {
+            remember_host_rssi(name, rssi);
+        }
+    }
+    for key in extra_keys {
+        if !key.is_empty() {
+            remember_host_rssi(key, rssi);
+        }
+    }
+}
