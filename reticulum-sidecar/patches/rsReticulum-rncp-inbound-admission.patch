+        let allowed = HashSet::new();
+        let blocked = HashSet::new();
+        let first = ([1; 16], [1; 32]);
+        let second = ([2; 16], [2; 32]);
+
+        state
+            .admit(
+                first.0,
+                first.1,
+                Some([9; 16]),
+                80,
+                1,
+                2,
+                limits,
+                true,
+                &allowed,
+                &blocked,
+            )
+            .expect("first admission");
+        state
+            .admit(
+                first.0,
+                first.1,
+                Some([9; 16]),
+                80,
+                2,
+                2,
+                limits,
+                true,
+                &allowed,
+                &blocked,
+            )
+            .expect("repeat segment for same resource");
+        assert_eq!(
+            state.admit(
+                first.0,
+                first.1,
+                Some([9; 16]),
+                80,
+                2,
+                2,
+                limits,
+                true,
+                &allowed,
+                &blocked,
+            ),
+            Err(RncpAdmissionReason::DeclaredSizeMismatch),
+            "a completed split sequence must not accept a replayed final segment"
+        );
+        assert_eq!(state.by_resource.len(), 1);
+        assert_eq!(state.reserved_bytes, 80);
+        assert_eq!(
+            state.admit(
+                [3; 16],
+                [3; 32],
+                Some([9; 16]),
+                10,
+                1,
+                1,
+                limits,
+                true,
+                &allowed,
+                &blocked,
+            ),
+            Err(RncpAdmissionReason::SenderBusy)
+        );
+        assert_eq!(
+            state.admit(
+                second.0,
+                second.1,
+                Some([8; 16]),
+                80,
+                1,
+                1,
+                limits,
+                true,
+                &allowed,
+                &blocked,
+            ),
+            Err(RncpAdmissionReason::ReservedBytesExceeded)
+        );
+
+        state.release(first).expect("release first");
+        assert_eq!(state.reserved_bytes, 0);
+        assert!(state.active_per_identity.is_empty());
+        state
+            .admit(
+                second.0,
+                second.1,
+                Some([8; 16]),
+                80,
+                1,
+                1,
+                limits,
+                true,
+                &allowed,
+                &blocked,
+            )
+            .expect("quota restored after release");
+    }
