+
+impl RncpAdmissionState {
+    #[allow(clippy::too_many_arguments)]
+    fn admit(
+        &mut self,
+        link_id: [u8; 16],
+        resource_id: [u8; 32],
+        identity_hash: Option<[u8; 16]>,
+        declared_bytes: usize,
+        segment_index: usize,
+        total_segments: usize,
+        limits: RncpInboundLimits,
+        allow_all: bool,
+        allowed: &HashSet<[u8; 16]>,
+        blocked: &HashSet<[u8; 16]>,
+    ) -> Result<(), RncpAdmissionReason> {
+        let Some(identity_hash) = identity_hash else {
+            return if limits.require_identified_sender {
+                Err(RncpAdmissionReason::IdentificationRequired)
+            } else {
+                Err(RncpAdmissionReason::NotAllowed)
+            };
+        };
+        if blocked.contains(&identity_hash) || (!allow_all && !allowed.contains(&identity_hash)) {
+            return Err(RncpAdmissionReason::NotAllowed);
+        }
+
+        let key = (link_id, resource_id);
+        if let Some(existing) = self.by_resource.get_mut(&key) {
+            if existing.completed
+                || total_segments <= 1
+                || existing.identity_hash != identity_hash
+                || existing.declared_bytes != declared_bytes
+                || existing.total_segments != total_segments
+                || segment_index != existing.next_segment_index
+                || segment_index > total_segments
+            {
+                return Err(RncpAdmissionReason::DeclaredSizeMismatch);
+            }
+            existing.next_segment_index = segment_index
+                .checked_add(1)
+                .ok_or(RncpAdmissionReason::DeclaredSizeMismatch)?;
+            return Ok(());
+        }
+        if segment_index != 1 || total_segments == 0 {
+            return Err(RncpAdmissionReason::DeclaredSizeMismatch);
+        }
+
+        let logical_limit = limits
+            .max_file_bytes
+            .checked_add(limits.max_metadata_bytes)
+            .and_then(|bytes| bytes.checked_add(3))
+            .ok_or(RncpAdmissionReason::FileTooLarge)?;
+        if declared_bytes > logical_limit {
+            return Err(RncpAdmissionReason::FileTooLarge);
+        }
+        if self.by_resource.len() >= limits.max_active_transfers {
+            return Err(RncpAdmissionReason::TooManyActive);
+        }
+        let peer_active = self
+            .active_per_identity
+            .get(&identity_hash)
+            .copied()
+            .unwrap_or(0);
+        if peer_active >= limits.max_active_per_identity {
+            return Err(RncpAdmissionReason::SenderBusy);
+        }
+        let reserved_bytes = self
+            .reserved_bytes
+            .checked_add(declared_bytes)
+            .ok_or(RncpAdmissionReason::ReservedBytesExceeded)?;
+        if reserved_bytes > limits.max_reserved_bytes {
+            return Err(RncpAdmissionReason::ReservedBytesExceeded);
+        }
+
+        self.by_resource.insert(
+            key,
+            RncpAdmission {
+                identity_hash,
+                declared_bytes,
+                total_segments,
+                next_segment_index: 2,
+                completed: false,
+            },
+        );
+        self.active_per_identity
+            .insert(identity_hash, peer_active + 1);
+        self.reserved_bytes = reserved_bytes;
+        Ok(())
+    }
+
+    fn mark_complete(&mut self, key: ([u8; 16], [u8; 32])) -> Option<RncpAdmission> {
+        let admission = self.by_resource.get_mut(&key)?;
+        admission.completed = true;
+        Some(*admission)
+    }
+
+    fn release(&mut self, key: ([u8; 16], [u8; 32])) -> Option<RncpAdmission> {
+        let admission = self.by_resource.remove(&key)?;
+        self.reserved_bytes = self.reserved_bytes.saturating_sub(admission.declared_bytes);
+        if let Some(active) = self.active_per_identity.get_mut(&admission.identity_hash) {
+            *active = active.saturating_sub(1);
+            if *active == 0 {
+                self.active_per_identity.remove(&admission.identity_hash);
+            }
+        }
+        Some(admission)
+    }
+
+    fn release_incomplete_for_link(&mut self, link_id: [u8; 16]) {
+        let keys: Vec<_> = self
+            .by_resource
+            .iter()
+            .filter_map(|(key, admission)| {
+                (key.0 == link_id && !admission.completed).then_some(*key)
+            })
+            .collect();
+        for key in keys {
+            self.release(key);
         }
     }
 }
 
+fn logical_resource_id(advertisement: &ResourceAdvertisement) -> [u8; 32] {
+    if advertisement.flags.split || advertisement.total_segments > 1 {
+        advertisement.original_hash
+    } else {
+        advertisement.resource_hash
