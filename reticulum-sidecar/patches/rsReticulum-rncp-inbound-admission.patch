+            }
+            existing.next_segment_index = segment_index
+                .checked_add(1)
+                .ok_or(RncpAdmissionReason::DeclaredSizeMismatch)?;
+            return Ok(());
+        }
+        if segment_index != 1 || total_segments == 0 {
+            return Err(RncpAdmissionReason::DeclaredSizeMismatch);
+        }
+
