+pub(crate) fn bounded_payload_size_is_valid(
+    data_bytes: usize,
+    metadata_bytes: Option<usize>,
+    declared_bytes: usize,
+    complete: bool,
+    (max_data_bytes, max_metadata_bytes): (usize, usize),
+) -> bool {
+    if data_bytes > max_data_bytes || metadata_bytes.is_some_and(|bytes| bytes > max_metadata_bytes)
+    {
+        return false;
+    }
+    let metadata_wire_bytes = match metadata_bytes {
+        Some(bytes) => match bytes.checked_add(3) {
+            Some(bytes) => bytes,
+            None => return false,
+        },
+        None => 0,
+    };
+    data_bytes
+        .checked_add(metadata_wire_bytes)
+        .is_some_and(|actual| actual <= declared_bytes && (!complete || actual == declared_bytes))
+}
