+                limits,
+                true,
+                &HashSet::new(),
+                &HashSet::new(),
+            )
+            .expect("admission");
+
+        let (legacy_tx, _legacy_rx) = mpsc::channel(1);
+        legacy_tx
+            .try_send(LinkResourceEvent::Progress {
+                link_id: [0xEE; 16],
+                resource_id: [0xEE; 32],
+                direction: LinkResourceDirection::Inbound,
+                transferred: 1,
+                total: 2,
+            })
+            .expect("fill legacy channel");
+        assert!(
+            legacy_tx
+                .try_send(LinkResourceEvent::Started {
+                    link_id,
+                    resource_id,
+                    direction: LinkResourceDirection::Inbound,
+                    data_size: 80,
+                    total_segments: 1,
+                })
+                .is_err()
+        );
+
+        let (accounting_tx, mut accounting_rx) = mpsc::unbounded_channel();
+        accounting_tx
+            .send(LinkManagerAccountingEvent::ResourceEvent(
+                LinkResourceEvent::Concluded {
+                    link_id,
+                    resource_id,
+                    direction: LinkResourceDirection::Inbound,
+                    conclusion: LinkResourceConclusion::Failed("test".into()),
+                },
+            ))
+            .expect("lossless accounting send");
+        let LinkManagerAccountingEvent::ResourceEvent(event) =
+            accounting_rx.try_recv().expect("terminal accounting event")
+        else {
+            panic!("expected ResourceEvent");
+        };
+        apply_admission_resource_event(&mut state, event);
+
+        assert!(state.by_resource.is_empty());
+        assert_eq!(state.reserved_bytes, 0);
+        assert!(state.active_per_identity.is_empty());
+    }
+
+    #[test]
+    fn link_close_releases_only_incomplete_admissions() {
+        let limits = inbound_limits();
+        let link_id = [0x61; 16];
+        let completed = (link_id, [0x62; 32]);
+        let incomplete = (link_id, [0x63; 32]);
+        let mut state = RncpAdmissionState::default();
+        for (key, identity) in [(completed, [0x64; 16]), (incomplete, [0x65; 16])] {
+            state
+                .admit(
+                    key.0,
+                    key.1,
+                    Some(identity),
+                    70,
+                    1,
+                    1,
+                    limits,
+                    true,
+                    &HashSet::new(),
+                    &HashSet::new(),
+                )
+                .expect("admission");
+        }
+        state.mark_complete(completed).expect("completed admission");
+
+        state.release_incomplete_for_link(link_id);
+
+        assert!(state.by_resource.contains_key(&completed));
+        assert!(!state.by_resource.contains_key(&incomplete));
+        assert_eq!(state.reserved_bytes, 70);
+        assert_eq!(state.active_per_identity.get(&[0x64; 16]), Some(&1));
+        assert!(!state.active_per_identity.contains_key(&[0x65; 16]));
+
+        state.release(completed).expect("payload ack release");
+        assert!(state.by_resource.is_empty());
+        assert_eq!(state.reserved_bytes, 0);
+        assert!(state.active_per_identity.is_empty());
+    }
+
+    #[test]
+    fn completed_payload_must_match_declared_and_actual_limits() {
+        let limits = inbound_limits();
+        let admission = RncpAdmission {
+            identity_hash: [7; 16],
+            declared_bytes: 63,
+            total_segments: 1,
+            next_segment_index: 2,
+            completed: true,
+        };
+        assert!(validate_completed_payload(Some(admission), 50, Some(10), limits).is_ok());
+        assert_eq!(
+            validate_completed_payload(Some(admission), 50, Some(9), limits),
+            Err(RncpAdmissionReason::DeclaredSizeMismatch)
+        );
+        assert_eq!(
+            validate_completed_payload(Some(admission), 101, None, limits),
+            Err(RncpAdmissionReason::FileTooLarge)
+        );
+        assert_eq!(
+            validate_completed_payload(Some(admission), 40, Some(21), limits),
+            Err(RncpAdmissionReason::MetadataTooLarge)
+        );
+        assert_eq!(
+            validate_completed_payload(None, 50, Some(10), limits),
+            Err(RncpAdmissionReason::DeclaredSizeMismatch)
+        );
+    }
