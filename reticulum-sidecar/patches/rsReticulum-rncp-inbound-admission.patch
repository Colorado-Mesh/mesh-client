+                limits,
+                true,
+                &HashSet::new(),
+                &HashSet::new(),
+            )
+            .expect("admission");
+
+        let (legacy_tx, _legacy_rx) = mpsc::channel(1);
+        legacy_tx
+            .try_send(LinkResourceEvent::Progress {
+                link_id: [0xEE; 16],
+                resource_id: [0xEE; 32],
+                direction: LinkResourceDirection::Inbound,
+                transferred: 1,
+                total: 2,
+            })
+            .expect("fill legacy channel");
+        assert!(
+            legacy_tx
+                .try_send(LinkResourceEvent::Started {
+                    link_id,
+                    resource_id,
+                    direction: LinkResourceDirection::Inbound,
+                    data_size: 80,
+                    total_segments: 1,
+                })
+                .is_err()
+        );
+
+        let (accounting_tx, mut accounting_rx) = mpsc::unbounded_channel();
+        accounting_tx
+            .send(LinkManagerAccountingEvent::ResourceEvent(
+                LinkResourceEvent::Concluded {
+                    link_id,
+                    resource_id,
+                    direction: LinkResourceDirection::Inbound,
+                    conclusion: LinkResourceConclusion::Failed("test".into()),
+                },
+            ))
+            .expect("lossless accounting send");
+        let LinkManagerAccountingEvent::ResourceEvent(event) =
+            accounting_rx.try_recv().expect("terminal accounting event")
+        else {
+            panic!("expected ResourceEvent");
+        };
+        apply_admission_resource_event(&mut state, event);
+
+        assert!(state.by_resource.is_empty());
+        assert_eq!(state.reserved_bytes, 0);
+        assert!(state.active_per_identity.is_empty());
+    }
