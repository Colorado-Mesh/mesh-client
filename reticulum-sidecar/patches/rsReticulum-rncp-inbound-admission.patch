+    fn link_close_releases_only_incomplete_admissions() {
+        let limits = inbound_limits();
+        let link_id = [0x61; 16];
+        let completed = (link_id, [0x62; 32]);
+        let incomplete = (link_id, [0x63; 32]);
+        let mut state = RncpAdmissionState::default();
+        for (key, identity) in [(completed, [0x64; 16]), (incomplete, [0x65; 16])] {
+            state
+                .admit(
+                    key.0,
+                    key.1,
+                    Some(identity),
+                    70,
+                    1,
+                    1,
+                    limits,
+                    true,
+                    &HashSet::new(),
+                    &HashSet::new(),
+                )
+                .expect("admission");
+        }
+        state.mark_complete(completed).expect("completed admission");
+
+        state.release_incomplete_for_link(link_id);
+
+        assert!(state.by_resource.contains_key(&completed));
+        assert!(!state.by_resource.contains_key(&incomplete));
+        assert_eq!(state.reserved_bytes, 70);
+        assert_eq!(state.active_per_identity.get(&[0x64; 16]), Some(&1));
+        assert!(!state.active_per_identity.contains_key(&[0x65; 16]));
+
+        state.release(completed).expect("payload ack release");
+        assert!(state.by_resource.is_empty());
+        assert_eq!(state.reserved_bytes, 0);
+        assert!(state.active_per_identity.is_empty());
+    }
