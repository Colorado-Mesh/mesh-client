+            .active_per_identity
+            .get(&identity_hash)
+            .copied()
+            .unwrap_or(0);
+        if peer_active >= limits.max_active_per_identity {
+            return Err(RncpAdmissionReason::SenderBusy);
+        }
+        let reserved_bytes = self
+            .reserved_bytes
+            .checked_add(declared_bytes)
+            .ok_or(RncpAdmissionReason::ReservedBytesExceeded)?;
+        if reserved_bytes > limits.max_reserved_bytes {
+            return Err(RncpAdmissionReason::ReservedBytesExceeded);
+        }
+
+        self.by_resource.insert(
+            key,
+            RncpAdmission {
+                identity_hash,
+                declared_bytes,
+                total_segments,
+                next_segment_index: 2,
+                completed: false,
+            },
+        );
+        self.active_per_identity
+            .insert(identity_hash, peer_active + 1);
+        self.reserved_bytes = reserved_bytes;
+        Ok(())
