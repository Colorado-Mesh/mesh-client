+    fn mark_complete(&mut self, key: ([u8; 16], [u8; 32])) -> Option<RncpAdmission> {
+        let admission = self.by_resource.get_mut(&key)?;
+        admission.completed = true;
+        Some(*admission)
+    }
+
+    fn release(&mut self, key: ([u8; 16], [u8; 32])) -> Option<RncpAdmission> {
+        let admission = self.by_resource.remove(&key)?;
+        self.reserved_bytes = self.reserved_bytes.saturating_sub(admission.declared_bytes);
+        if let Some(active) = self.active_per_identity.get_mut(&admission.identity_hash) {
+            *active = active.saturating_sub(1);
+            if *active == 0 {
+                self.active_per_identity.remove(&admission.identity_hash);
+            }
+        }
+        Some(admission)
+    }
+
+    fn release_incomplete_for_link(&mut self, link_id: [u8; 16]) {
+        let keys: Vec<_> = self
+            .by_resource
+            .iter()
+            .filter_map(|(key, admission)| {
+                (key.0 == link_id && !admission.completed).then_some(*key)
+            })
+            .collect();
+        for key in keys {
+            self.release(key);
