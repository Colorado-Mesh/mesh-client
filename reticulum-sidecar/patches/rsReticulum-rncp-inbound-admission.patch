+/// Optional application limits; stock rncp retains its existing defaults.
+#[derive(Debug, Clone, Copy)]
+pub struct RncpFetchLimits {
+    pub max_file_bytes: usize,
+    pub max_metadata_bytes: usize,
+}
+
+enum FetchAdvertisementAdmission {
+    New,
+    ActiveDuplicate,
+    CompletedDuplicate(Vec<u8>),
+}
+
+struct FetchReceiveBudget {
+    limits: RncpFetchLimits,
+    first: Option<ResourceAdvertisement>,
+    active: Option<ResourceAdvertisement>,
+    completed: HashMap<usize, (Vec<u8>, Vec<u8>)>,
+    file_bytes: usize,
+    metadata_bytes: Option<usize>,
+    active_wire_bytes: usize,
+}
+
+impl FetchReceiveBudget {
+    fn new(limits: RncpFetchLimits) -> Self {
+        Self {
+            limits,
+            first: None,
+            active: None,
+            completed: HashMap::new(),
+            file_bytes: 0,
+            metadata_bytes: None,
+            active_wire_bytes: 0,
+        }
+    }
+
+    fn check_advertisement(
+        &self,
+        adv: &ResourceAdvertisement,
+        request_id: &[u8; 16],
+    ) -> Result<FetchAdvertisementAdmission, RncpError> {
+        let denied = || RncpError::ResourceFailed("fetch response exceeded receive limits".into());
+        let Some(max_declared) = self
+            .limits
+            .max_file_bytes
+            .checked_add(self.limits.max_metadata_bytes)
+            .and_then(|bytes| bytes.checked_add(3))
+        else {
+            return Err(denied());
+        };
+        if adv.data_size > max_declared
+            || adv.total_segments == 0
+            || adv.total_segments > rns_protocol::resource::MAX_SEGMENTS
+            || adv.segment_index == 0
+            || adv.segment_index > adv.total_segments
+            || adv.flags.is_request
+            || adv
+                .request_id
+                .as_ref()
+                .is_some_and(|id| id.as_slice() != request_id)
+            || (adv.flags.is_response && adv.request_id.is_none())
+        {
+            return Err(denied());
+        }
+        if let Some(first) = &self.first {
+            if adv.original_hash != first.original_hash
+                || adv.data_size != first.data_size
+                || adv.total_segments != first.total_segments
+                || adv.flags.split != first.flags.split
+                || adv.flags.is_response != first.flags.is_response
+                || adv.request_id != first.request_id
+            {
+                return Err(denied());
+            }
+        }
+        if let Some((advertisement, proof)) = self.completed.get(&adv.segment_index) {
+            return if *advertisement == adv.pack() {
+                Ok(FetchAdvertisementAdmission::CompletedDuplicate(
+                    proof.clone(),
+                ))
+            } else {
+                Err(denied())
+            };
+        }
+        if let Some(active) = &self.active {
+            return if active.pack() == adv.pack() {
+                Ok(FetchAdvertisementAdmission::ActiveDuplicate)
+            } else {
+                Err(denied())
+            };
+        }
+        if adv.segment_index != self.completed.len() + 1 {
+            return Err(denied());
+        }
+        Ok(FetchAdvertisementAdmission::New)
+    }
+
+    fn admit(&mut self, adv: &ResourceAdvertisement) {
+        if self.first.is_none() {
+            self.first = Some(adv.clone());
+        }
+        self.active = Some(adv.clone());
+        self.active_wire_bytes = 0;
+    }
+
+    fn admit_part(
+        &mut self,
+        resource: &rns_protocol::resource::InboundResource,
+        body: &[u8],
+    ) -> Result<bool, RncpError> {
+        let denied = || RncpError::ResourceFailed("fetch response exceeded wire limits".into());
+        // Check before cloning or retaining the packet. Parts must fit the
+        // negotiated SDU and their combined ciphertext must fit the advertisement.
+        if body.len() > resource.sdu {
+            return Err(denied());
+        }
+        let hash = rns_protocol::resource::get_map_hash(body, &resource.random_hash);
+        let start = resource.consecutive_completed;
+        let end = start
+            .saturating_add(resource.window.window)
+            .min(resource.total_parts);
+        let new_part = (start..end).any(|index| {
+            resource.map_hashes.get(index) == Some(&hash) && resource.parts[index].is_none()
+        });
+        if !new_part {
+            return Ok(false);
+        }
+        let bytes = self
+            .active_wire_bytes
+            .checked_add(body.len())
+            .ok_or_else(denied)?;
+        if bytes > resource.total_size {
+            return Err(denied());
+        }
+        self.active_wire_bytes = bytes;
+        Ok(true)
+    }
+
+    fn check_payload(&self, bytes: usize, metadata: Option<usize>) -> Result<(), RncpError> {
+        let denied = || RncpError::ResourceFailed("fetch response exceeded receive limits".into());
+        let first = self.first.as_ref().ok_or_else(denied)?;
+        let active = self.active.as_ref().ok_or_else(denied)?;
+        let total = self.file_bytes.checked_add(bytes).ok_or_else(denied)?;
+        if (active.segment_index == 1 && metadata.is_some() != first.flags.has_metadata)
+            || (active.segment_index > 1 && metadata.is_some())
+            || !crate::link_manager::bounded_payload_size_is_valid(
+                total,
+                self.metadata_bytes.or(metadata),
+                first.data_size,
+                active.segment_index == first.total_segments,
+                (self.limits.max_file_bytes, self.limits.max_metadata_bytes),
+            )
+        {
+            return Err(denied());
+        }
+        Ok(())
+    }
+
+    fn conclude(&mut self, bytes: usize, metadata: Option<usize>, proof: Vec<u8>) {
+        let active = self.active.take().expect("validated active fetch segment");
+        self.file_bytes += bytes;
+        self.metadata_bytes = self.metadata_bytes.or(metadata);
+        self.completed
+            .insert(active.segment_index, (active.pack(), proof));
+    }
