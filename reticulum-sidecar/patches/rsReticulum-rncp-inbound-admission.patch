+            .max_file_bytes
+            .checked_add(limits.max_metadata_bytes)
+            .and_then(|bytes| bytes.checked_add(3))
+            .ok_or(RncpAdmissionReason::FileTooLarge)?;
+        if declared_bytes > logical_limit {
+            return Err(RncpAdmissionReason::FileTooLarge);
+        }
+        if self.by_resource.len() >= limits.max_active_transfers {
+            return Err(RncpAdmissionReason::TooManyActive);
+        }
