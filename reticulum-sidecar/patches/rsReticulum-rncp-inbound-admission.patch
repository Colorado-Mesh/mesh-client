+fn apply_admission_resource_event(state: &mut RncpAdmissionState, event: LinkResourceEvent) {
+    if let LinkResourceEvent::Concluded {
+        link_id,
+        resource_id,
+        direction: LinkResourceDirection::Inbound,
+        conclusion,
+    } = event
+    {
+        let key = (link_id, resource_id);
+        // File completions are marked before their terminal event and remain
+        // reserved until the payload owner acknowledges them. Request Resources
+        // have no payload completion, so their terminal event releases admission.
+        let awaiting_payload_ack = state
+            .by_resource
+            .get(&key)
+            .is_some_and(|entry| entry.completed);
+        if conclusion != LinkResourceConclusion::Complete || !awaiting_payload_ack {
+            state.release(key);
+        }
+    }
+}
+
+fn validate_completed_payload(
+    admission: Option<RncpAdmission>,
+    file_bytes: usize,
+    metadata_bytes: Option<usize>,
+    limits: RncpInboundLimits,
+) -> Result<RncpAdmission, RncpAdmissionReason> {
+    if metadata_bytes.is_some_and(|bytes| bytes > limits.max_metadata_bytes) {
+        return Err(RncpAdmissionReason::MetadataTooLarge);
+    }
+    if file_bytes > limits.max_file_bytes {
+        return Err(RncpAdmissionReason::FileTooLarge);
+    }
+    let actual_logical_bytes = file_bytes
+        .checked_add(match metadata_bytes {
+            None => 0,
+            Some(bytes) => 3usize
+                .checked_add(bytes)
+                .ok_or(RncpAdmissionReason::DeclaredSizeMismatch)?,
+        })
+        .ok_or(RncpAdmissionReason::DeclaredSizeMismatch)?;
+    let admission = admission.ok_or(RncpAdmissionReason::DeclaredSizeMismatch)?;
+    if actual_logical_bytes != admission.declared_bytes {
+        return Err(RncpAdmissionReason::DeclaredSizeMismatch);
+    }
+    Ok(admission)
+}
