<component type="desktop-application">
  <id>org.coloradomesh.MeshClient</id>
  <name>Mesh Client</name>
  <summary>Meshtastic, MeshCore, and Reticulum mesh network client</summary>
  <metadata_license>MIT</metadata_license>
  <project_license>MIT</project_license>
  <description>
    <p>
      Mesh Client is a desktop application for communicating with Meshtastic,
      MeshCore, and Reticulum mesh networks via Bluetooth LE, USB serial, and MQTT.
      It supports diagnostics, channel management, node mapping, and direct
      messaging across all three protocols simultaneously.
    </p>
  </description>
