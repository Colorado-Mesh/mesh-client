# We use the JSR registry since it's better for typescript and also because it's where @meshtastic lives.
@jsr:registry=https://npm.jsr.io
# Electron embeds Chromium; Playwright browser downloads are unused for Electron E2E.
PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
# Align with pnpm-workspace minimumReleaseAge: 720 minutes (12h). Semgrep's npm
# rule defaults to 7 days; project policy stays 12h (see prefer-latest-packages).
# nosemgrep: package_managers.npm.npm-missing-minimum-release-age.npm-missing-minimum-release-age
min-release-age=0.5
